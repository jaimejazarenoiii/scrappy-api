generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  OWNER
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  INACTIVE
}

enum AttendanceSessionStatus {
  OPEN
  CLOSED
}

enum LeaveType {
  HALF_DAY
  FULL_DAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CashAdvanceStatus {
  OUTSTANDING
  SETTLED
}

enum PayrollStatus {
  PAYABLE
  PAID
}

enum TransactionDirection {
  INBOUND
  OUTBOUND
}

enum TransactionStatus {
  DRAFT
  READY_FOR_PAYMENT
  PAID
  CANCELLED
}

enum TransactionLocationType {
  BRANCH
  WAREHOUSE
  OUTSIDE
}

enum TransactionAttachmentType {
  PHOTO
}

enum TransactionItemUnit {
  KG
  G
  TON
  LB
  PIECE
  BUNDLE
  SACK
}

model Company {
  id                 String              @id @default(uuid())
  name               String              @unique
  logoUrl            String?
  contactNumber      String?
  email              String?
  address            String?
  status             CompanyStatus       @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  users              User[]
  employees          Employee[]
  branches           Branch[]
  warehouses         Warehouse[]
  vehicles           Vehicle[]
  attendanceSessions AttendanceSession[]
  leaveRecords       LeaveRecord[]
  cashAdvances       CashAdvance[]
  payrollRecords     PayrollRecord[]
  transactions       Transaction[]
}

model User {
  id           String           @id @default(uuid())
  companyId    String
  employeeId   String?          @unique
  email        String           @unique
  passwordHash String
  role         UserRole
  lastLoginAt  DateTime?
  status       UserStatus       @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  company      Company          @relation(fields: [companyId], references: [id])
  employee     Employee?        @relation("UserEmployeeLink", fields: [employeeId], references: [id])
  sessions     RefreshSession[]

  @@index([companyId, role])
}

model Employee {
  id                     String                          @id @default(uuid())
  companyId              String
  userId                 String?                         @unique
  employeeNumber         String?
  firstName              String
  middleName             String?
  lastName               String
  suffix                 String?
  contactNumber          String?
  weeklySalary           Decimal                         @db.Decimal(10, 2)
  status                 EmployeeStatus                  @default(ACTIVE)
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  deletedAt              DateTime?
  company                Company                         @relation(fields: [companyId], references: [id])
  user                   User?                           @relation("UserEmployeeLink")
  attendanceSessions     AttendanceSession[]
  leaveRecords           LeaveRecord[]
  cashAdvances           CashAdvance[]
  payrollRecords         PayrollRecord[]
  transactionAssignments TransactionEmployeeAssignment[]

  @@unique([companyId, employeeNumber])
  @@index([companyId, lastName])
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Branch {
  id              String        @id @default(uuid())
  companyId       String
  name            String
  address         String
  contactNumber   String
  status          BranchStatus  @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  createdByUserId String?
  updatedByUserId String?
  company         Company       @relation(fields: [companyId], references: [id])
  transactions    Transaction[]

  @@index([companyId, status])
  @@index([companyId, deletedAt])
}

model Warehouse {
  id              String          @id @default(uuid())
  companyId       String
  name            String
  address         String
  contactNumber   String
  status          WarehouseStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  createdByUserId String?
  updatedByUserId String?
  company         Company         @relation(fields: [companyId], references: [id])
  transactions    Transaction[]

  @@index([companyId, status])
  @@index([companyId, deletedAt])
}

model Vehicle {
  id              String        @id @default(uuid())
  companyId       String
  plateNumber     String
  description     String
  status          VehicleStatus @default(AVAILABLE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  createdByUserId String?
  updatedByUserId String?
  company         Company       @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([companyId, deletedAt])
}

model AttendanceSession {
  id                String                  @id @default(uuid())
  companyId         String
  employeeId        String
  status            AttendanceSessionStatus @default(OPEN)
  timeInAt          DateTime
  timeOutAt         DateTime?
  note              String?
  correctionNote    String?
  adjustedTimeInAt  DateTime?
  adjustedTimeOutAt DateTime?
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  company           Company                 @relation(fields: [companyId], references: [id])
  employee          Employee                @relation(fields: [employeeId], references: [id])

  @@index([companyId, employeeId, status])
  @@index([companyId, employeeId, timeInAt])
  @@index([companyId, timeInAt])
}

model LeaveRecord {
  id              String      @id @default(uuid())
  companyId       String
  employeeId      String
  leaveType       LeaveType
  leaveDate       DateTime    @db.Date
  status          LeaveStatus @default(PENDING)
  reason          String?
  managerNote     String?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  company         Company     @relation(fields: [companyId], references: [id])
  employee        Employee    @relation(fields: [employeeId], references: [id])

  @@index([companyId, employeeId, leaveDate])
  @@index([companyId, status])
}

model CashAdvance {
  id              String            @id @default(uuid())
  companyId       String
  employeeId      String
  amount          Decimal           @db.Decimal(10, 2)
  deductedAmount  Decimal           @default(0) @db.Decimal(10, 2)
  remainingAmount Decimal           @db.Decimal(10, 2)
  status          CashAdvanceStatus @default(OUTSTANDING)
  reason          String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  company         Company           @relation(fields: [companyId], references: [id])
  employee        Employee          @relation(fields: [employeeId], references: [id])

  @@index([companyId, employeeId, status])
  @@index([companyId, createdAt])
}

model PayrollRecord {
  id                    String        @id @default(uuid())
  companyId             String
  employeeId            String
  payPeriodStart        DateTime      @db.Date
  payPeriodEnd          DateTime      @db.Date
  grossSalary           Decimal       @db.Decimal(10, 2)
  cashAdvanceDeductions Decimal       @default(0) @db.Decimal(10, 2)
  netPay                Decimal       @db.Decimal(10, 2)
  status                PayrollStatus @default(PAYABLE)
  paidAt                DateTime?
  paymentReference      String?
  createdByUserId       String?
  updatedByUserId       String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  company               Company       @relation(fields: [companyId], references: [id])
  employee              Employee      @relation(fields: [employeeId], references: [id])

  @@unique([companyId, employeeId, payPeriodStart])
  @@index([companyId, payPeriodStart, payPeriodEnd])
  @@index([companyId, status])
}

model Transaction {
  id                  String                          @id @default(uuid())
  companyId           String
  createdByUserId     String
  updatedByUserId     String?
  transactionNumber   String
  direction           TransactionDirection
  status              TransactionStatus               @default(DRAFT)
  partyName           String
  partyContactNumber  String?
  transactionDate     DateTime
  locationType        TransactionLocationType
  branchId            String?
  warehouseId         String?
  outsideLocationName String?
  outsideAddress      String?
  tripId              String?
  notes               String?
  submittedAt         DateTime?
  submittedByUserId   String?
  paidAt              DateTime?
  paidByUserId        String?
  cancellationReason  String?
  cancelledAt         DateTime?
  cancelledByUserId   String?
  reopenedAt          DateTime?
  reopenedByUserId    String?
  reopenReason        String?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  deletedAt           DateTime?
  company             Company                         @relation(fields: [companyId], references: [id])
  branch              Branch?                         @relation(fields: [branchId], references: [id])
  warehouse           Warehouse?                      @relation(fields: [warehouseId], references: [id])
  items               TransactionItem[]
  attachments         TransactionAttachment[]
  assignments         TransactionEmployeeAssignment[]

  @@unique([companyId, transactionNumber])
  @@index([companyId, status, deletedAt])
  @@index([companyId, transactionNumber])
  @@index([companyId, transactionDate])
  @@index([companyId, direction, status])
  @@index([companyId, submittedAt])
  @@index([companyId, paidAt])
  @@index([companyId, locationType])
  @@index([companyId, branchId])
  @@index([companyId, warehouseId])
  @@index([companyId, createdByUserId])
  @@index([companyId, deletedAt, transactionDate])
}

model TransactionNumberSequence {
  companyId    String
  direction    TransactionDirection
  sequenceDate DateTime             @db.Date
  lastSequence Int                  @default(0)

  @@id([companyId, direction, sequenceDate])
  @@index([companyId, sequenceDate])
}

model TransactionItem {
  id            String              @id @default(uuid())
  transactionId String
  materialName  String
  weight        Decimal             @db.Decimal(12, 3)
  unit          TransactionItemUnit
  price         Decimal             @db.Decimal(12, 2)
  total         Decimal             @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  transaction   Transaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([transactionId, materialName])
}

model TransactionAttachment {
  id               String                    @id @default(uuid())
  transactionId    String
  attachmentType   TransactionAttachmentType @default(PHOTO)
  fileName         String
  filePath         String
  mimeType         String
  fileSize         Int
  uploadedByUserId String
  createdAt        DateTime                  @default(now())
  transaction      Transaction               @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([transactionId, attachmentType])
}

model TransactionEmployeeAssignment {
  transactionId String
  employeeId    String
  assignedAt    DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  employee      Employee    @relation(fields: [employeeId], references: [id])

  @@id([transactionId, employeeId])
  @@index([employeeId, transactionId])
  @@index([employeeId])
}
