# Copy to .env and adjust values.
# docker compose automatically reads .env for ${VAR} substitution and loads it into containers via env_file.

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=scrappy
POSTGRES_PORT=5432

# --- API ---
PORT=3000
# Local host URL (pnpm dev). docker-compose overrides this for the api service to use host "postgres".
DATABASE_URL=postgresql://postgres:change-me-strong-password@localhost:5432/scrappy?schema=public
NODE_ENV=production
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- File storage ---
# Default: local in development/test, s3 in production.
# Override explicitly if needed, e.g. FILE_STORAGE_DRIVER=local for docker without S3.
FILE_STORAGE_DRIVER=s3
UPLOAD_DIR=uploads

# Required when FILE_STORAGE_DRIVER=s3 (or NODE_ENV=production without overriding to local)
S3_BUCKET=your-bucket-name
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
# Optional: Cloudflare R2 / MinIO endpoint
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
